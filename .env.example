# ---------------------------------------------------------------------------
# Job Application Copilot — environment template
#
# EVERY VALUE BELOW IS A DUMMY PLACEHOLDER. None of these keys work.
# Copy to .env and replace with your own credentials:   cp .env.example .env
# .env is git-ignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- App ---------------------------------------------------------------
APP_ENV=dev                              # dev | staging | prod
APP_LOG_LEVEL=INFO
APP_CONFIG_DIR=config
APP_PROMPTS_DIR=prompts
APP_OUTPUT_DIR=outputs

# JWT used between Next.js (Auth.js) and FastAPI. Generate: openssl rand -hex 32
APP_JWT_SECRET=dummy-jwt-secret-change-me-0000000000000000000000000000
APP_JWT_AUDIENCE=job-copilot
APP_CORS_ORIGINS=http://localhost:3000

# --- LLM providers (selected by config/llm.yaml -> provider_profile) ----
# Override the profile without editing YAML:
LLM_PROVIDER_PROFILE=anthropic           # anthropic | openai | gemini | azure | ollama | fake
ANTHROPIC_API_KEY=sk-ant-dummy-00000000000000000000000000000000
OPENAI_API_KEY=sk-dummy-00000000000000000000000000000000
GEMINI_API_KEY=dummy-gemini-key-000000000000000000
AZURE_API_KEY=dummy-azure-openai-key-0000000000000000
AZURE_API_BASE=https://dummy-resource.openai.azure.com
AZURE_API_VERSION=2024-10-21
OLLAMA_API_BASE=http://localhost:11434

# Embeddings (config/llm.yaml -> embedding_profile)
EMBEDDING_PROFILE=local                  # local | openai | hashing

# --- Vector DB ---------------------------------------------------------
VECTOR_STORE=qdrant                      # qdrant | memory (memory = no infra, dev only)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=dummy-qdrant-api-key-0000000000

# --- Relational DB / cache / files ------------------------------------
DATABASE_URL=postgresql+psycopg://copilot:dummy-db-password@localhost:5432/copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=dummy-db-password
POSTGRES_DB=copilot
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=copilot-artifacts
S3_ACCESS_KEY_ID=dummy-minio-access-key
S3_SECRET_ACCESS_KEY=dummy-minio-secret-key-000000000

# --- Job sources -------------------------------------------------------
# Adzuna developer keys: https://developer.adzuna.com/
ADZUNA_APP_ID=dummy-adzuna-app-id
ADZUNA_APP_KEY=dummy-adzuna-app-key-0000000000000000
ADZUNA_COUNTRY=in

# --- Calendar (calendar-mcp) -------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=dummy-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=dummy-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- MCP servers -------------------------------------------------------
MCP_JOBBOARD_URL=http://localhost:8101/mcp
MCP_DOCGEN_URL=http://localhost:8102/mcp
MCP_CALENDAR_URL=http://localhost:8103/mcp
MCP_SHARED_BEARER_TOKEN=dummy-mcp-bearer-token-000000000000

# --- Observability (self-hosted Langfuse) ------------------------------
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-dummy-00000000-0000-0000-0000-000000000000
LANGFUSE_SECRET_KEY=sk-lf-dummy-00000000-0000-0000-0000-000000000000
TRACING_ENABLED=false                    # set true once Langfuse is running
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Next.js (web/.env.local) ------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
AUTH_SECRET=dummy-authjs-secret-change-me-00000000000000
AUTH_GOOGLE_ID=dummy-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=dummy-google-client-secret
